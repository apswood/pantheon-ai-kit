# =========================================================================
# Support Governance & Multi-Agent Starter Kit - Environment Configuration
# =========================================================================
# Copy this file to '.env' in your project root or subproject directory.
# Populate the values below with your environment-specific credentials.
#
# 🔒 SECURITY WARNING:
# NEVER commit the active '.env' file to Git or version control!
# The active '.env' file is strictly ignored by '.gitignore' to protect
# secrets, API keys, and corporate tenant credentials from leaking.
# =========================================================================

# -------------------------------------------------------------------------
# 1. ITSM & Service Desk Configuration (ServiceNow / Jira / Generic ITSM)
# -------------------------------------------------------------------------
# The base URL of your primary ITSM instance (e.g., https://your-company.service-now.com).
# Used by ingestion scripts and ticket summary exporters to query REST APIs.
INSTANCE_URL=https://<your-instance>.service-now.com

# Production instance URL. When testing in a development or staging sub-instance,
# this fallback URL allows credential engines (such as Windows SecretStore) to resolve
# production credentials if development credentials are not separately configured.
SN_PROD_INSTANCE_URL=https://<your-instance>.service-now.com

# ITSM API Basic Authentication Credentials.
# Used if you do not use OS-level credential vaults (e.g., Windows SecretStore).
# Leave empty if your runtime environment resolves credentials via SecretStore or OAuth tokens.
SN_USERNAME=
SN_PASSWORD=

# Target Department / Organization unique identifier (sys_id in ServiceNow).
# Ingestion scripts use this identifier to query tickets belonging to your support organization.
SN_DEPARTMENT_SYS_ID=

# -------------------------------------------------------------------------
# 2. Cloud Storage, Database & Graph API (SharePoint / Graph / Cosmos DB)
# -------------------------------------------------------------------------
# Microsoft Graph API root endpoint (Standard commercial: https://graph.microsoft.com).
GRAPH_RESOURCE=https://graph.microsoft.com

# Microsoft Entra ID (formerly Azure AD) Directory / Tenant GUID.
# Find this in Azure Portal -> Microsoft Entra ID -> Overview -> Tenant ID.
SHAREPOINT_TENANT_ID=00000000-0000-0000-0000-000000000000

# SharePoint Site Path in Microsoft Graph format: "<tenant>.sharepoint.com:/sites/<site-name>".
# Example: "contoso.sharepoint.com:/sites/ServiceOperations"
# Used by Graph API routines to synchronize manual ticket lists and publish quality audit records.
SHAREPOINT_SITE_PATH=yourtenant.sharepoint.com:/sites/<your-site>

# Azure Cosmos DB / NoSQL Database Connection (Optional, for web analytics storage).
# Find these in Azure Portal -> Azure Cosmos DB account -> Keys.
COSMOS_ENDPOINT=https://<your-cosmos-endpoint>.documents.azure.com:443/
COSMOS_KEY=<your-cosmos-primary-key>
COSMOS_DATABASE=scorecardDB
COSMOS_CONTAINER=TicketReview

# -------------------------------------------------------------------------
# 3. Notification & Automation Webhooks (Teams / Slack / Power Automate)
# -------------------------------------------------------------------------
# Incoming Webhook URL for Daily Standup Notification Card.
# Create this in Microsoft Teams -> Channel -> Connectors/Workflows -> Incoming Webhook.
TEAMS_DIGEST_WEBHOOK=https://<your-webhook-endpoint-url>

# Webhook URL for triggering the Backlog Review Power Automate Flow or external worker.
# Provided by Power Automate "When an HTTP request is received" trigger.
POWER_AUTOMATE_WEBHOOK=https://<your-webhook-endpoint-url>

# Power Automate Package Deployment Identifiers (Used when packaging custom flow definitions).
# GUID of the target SharePoint Backlog list:
PA_SHAREPOINT_LIST_ID=00000000-0000-0000-0000-000000000000
# GUID of the target SharePoint list view:
PA_BACKLOG_LIST_VIEW_ID=00000000-0000-0000-0000-000000000000
# Microsoft Teams Thread/Chat ID where standup notifications are posted:
PA_TEAMS_CHAT_ID=19:<chat-id>@thread.v2
# Existing Connection Reference names in the target Power Automate environment:
PA_SP_CONNECTION_NAME=shared_sharepointonline
PA_TEAMS_CONNECTION_NAME=shared_teams
# Service account email designated as the flow and connection owner:
PA_FLOW_OWNER_EMAIL=service.account@your-company.com

# -------------------------------------------------------------------------
# 4. Analytics Dashboard Security & Authentication
# -------------------------------------------------------------------------
# Basic Authentication credentials for protecting the FastAPI analytics dashboard endpoints.
# The server will fail to start if DASHBOARD_USERNAME or DASHBOARD_PASSWORD are unset.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ChangeThisToASecureRandomPassword!

# Network binding configuration for the analytics server:
DASHBOARD_PORT=8000
DASHBOARD_HOST=0.0.0.0

# -------------------------------------------------------------------------
# 5. Operational Governance Targets & Thresholds (Optional Overrides)
# -------------------------------------------------------------------------
# Default KPI thresholds utilized by the governance calculation engines.
# Leave commented or adjust to customize targets for your operational teams.

# Daily engineer time worked target in minutes (Standard: 315 minutes = 5.25 hours)
TARGET_DAILY_PACING_MINUTES=315

# Daily closed ticket throughput target per engineer (Standard: 2 completed tasks/day)
TARGET_DAILY_CLOSED_TASKS=2

# Minimum proactive problem/RCA workload percentage (Standard: 10% of recorded time)
TARGET_PROACTIVE_WORK_PCT=10

# Ticket stagnancy threshold in working days without updates (Standard: 5 working days)
STALE_TICKET_DAYS_THRESHOLD=5

# Working day business hours window (Used for staleness calculation)
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:30

# Timezone identifier for business hours calculation (IANA format)
TIMEZONE=Europe/London
